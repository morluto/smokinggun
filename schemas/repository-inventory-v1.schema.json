{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "smokinggun.repository-inventory.v1"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "language",
          "files",
          "extensions"
        ],
        "additionalProperties": false
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packageManagers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "languages",
    "manifests",
    "packageManagers",
    "tests",
    "benchmarks",
    "generated",
    "ignored",
    "digest"
  ],
  "additionalProperties": false
}
