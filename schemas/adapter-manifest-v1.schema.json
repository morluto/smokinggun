{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "footgun.adapter-manifest.v1"
    },
    "protocolVersion": {
      "default": "footgun.adapter.v1",
      "type": "string",
      "const": "footgun.adapter.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputKinds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputKinds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sideEffects": {
      "default": [
        "execute"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "execute",
          "write",
          "network",
          "service",
          "resource"
        ]
      }
    },
    "determinism": {
      "default": "environment-sensitive",
      "type": "string",
      "enum": [
        "deterministic",
        "seeded",
        "environment-sensitive",
        "nondeterministic"
      ]
    },
    "probeCommand": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxArtifactBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeoutMs",
        "maxOutputBytes",
        "maxArtifactBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "id",
    "version",
    "command",
    "languages",
    "capabilities",
    "inputKinds",
    "outputKinds",
    "requirements",
    "sideEffects",
    "determinism",
    "limits"
  ],
  "additionalProperties": false
}
