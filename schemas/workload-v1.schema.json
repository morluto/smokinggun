{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "footgun.workload.v1"
    },
    "command": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "inheritEnvironment": {
      "type": "boolean"
    },
    "warmups": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repetitions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "inputSizeParameterization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "commandIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "values",
        "commandIndex"
      ],
      "additionalProperties": false
    },
    "datasetDigests": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "cpuMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "memoryBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxProcesses": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "docker",
            "podman",
            "bwrap",
            "nsjail"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "runtime"
      ],
      "additionalProperties": false
    },
    "statisticalPolicy": {
      "default": {
        "kind": "median-improvement",
        "minimumRelativeImprovement": 0
      },
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "median-improvement",
            "non-overlapping-iqr"
          ]
        },
        "minimumRelativeImprovement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "minimumRelativeImprovement"
      ],
      "additionalProperties": false
    },
    "requestedProfile": {
      "type": "string",
      "enum": [
        "read-only",
        "local-exec",
        "service-exec",
        "container-exec",
        "candidate-write"
      ]
    },
    "expectedArtifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behaviorChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "networkPolicy": {
      "default": "disabled",
      "type": "string",
      "enum": [
        "disabled",
        "explicit"
      ]
    },
    "candidateRoot": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "cwd",
    "environment",
    "inheritEnvironment",
    "warmups",
    "repetitions",
    "timeoutMs",
    "datasetDigests",
    "statisticalPolicy",
    "requestedProfile",
    "expectedArtifacts",
    "behaviorChecks",
    "networkPolicy"
  ],
  "additionalProperties": false
}
