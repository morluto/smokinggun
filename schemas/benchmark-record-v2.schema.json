            "type": "number",
            "minimum": 0
          }
        },
        "medianMs": {
          "type": "number",
          "minimum": 0
        },
        "meanMs": {
          "type": "number",
          "minimum": 0
        },
        "sourceUnit": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "rawArtifact": {
          "type": "string",
          "minLength": 1
        },
        "rawArtifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "tool",
        "name",
        "samplesMs",
        "medianMs",
        "meanMs",
        "sourceUnit",
        "metadata",
        "rawArtifact"
      ],
      "additionalProperties": false
    },
