{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "footgun.scaling.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^scale_[a-f0-9]{16}$"
    },
    "investigation": {
      "type": "string"
    },
    "workloadDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parameters": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coordinatesDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "points": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "samplesMs": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "medianMs": {
            "type": "number",
            "minimum": 0
          },
          "meanMs": {
            "type": "number",
            "minimum": 0
          },
          "quartiles": {
            "type": "object",
            "properties": {
              "q1Ms": {
                "type": "number",
                "minimum": 0
              },
              "q3Ms": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "q1Ms",
              "q3Ms"
            ],
            "additionalProperties": false
          },
          "statisticalPolicy": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "median-improvement",
                  "non-overlapping-iqr"
                ]
              },
              "minimumRelativeImprovement": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind",
              "minimumRelativeImprovement"
            ],
            "additionalProperties": false
          },
          "timedOut": {
            "type": "boolean"
          },
          "behaviorValidated": {
            "type": "boolean"
          },
          "isolation": {
            "type": "object",
            "properties": {
              "backend": {
                "type": "string",
                "enum": [
                  "host-process",
                  "docker",
                  "podman",
                  "bwrap",
                  "nsjail"
                ]
              },
              "controlsRequested": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "controlsApplied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "downgradeReasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "candidateWorkspace": {
                "type": "string"
              },
              "runner": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string",
                    "enum": [
                      "docker",
                      "podman",
                      "bwrap",
                      "nsjail"
                    ]
                  },
                  "image": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "runtime"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "backend",
              "controlsRequested",
              "controlsApplied",
              "downgradeReasons"
            ],
            "additionalProperties": false
          },
          "diagnostic": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "timed-out",
              "failed",
              "cancelled"
            ]
          },
          "coordinates": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "value",
          "samplesMs",
          "medianMs",
          "meanMs",
          "quartiles",
          "statisticalPolicy",
          "timedOut",
          "behaviorValidated",
          "status",
          "coordinates"
        ],
        "additionalProperties": false
      }
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "environmentKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "warmups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repetitions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "expectedArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "datasetDigests": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "command",
        "cwd",
        "environmentKeys",
        "timeoutMs",
        "warmups",
        "repetitions",
        "expectedArtifacts",
        "datasetDigests"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "platform",
        "arch"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "workloadDigest",
    "parameters",
    "coordinatesDigest",
    "points",
    "reproduction",
    "environment",
    "limitations"
  ],
  "additionalProperties": false
}
