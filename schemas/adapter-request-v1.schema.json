{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "footgun.adapter-request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "operation": {
      "default": "scan",
      "type": "string",
      "enum": [
        "probe",
        "scan",
        "context",
        "benchmark",
        "profile",
        "trace"
      ]
    },
    "targets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestedCapabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionPolicy": {
      "default": {
        "network": "disabled",
        "shell": false,
        "maxOutputBytes": 1000000
      },
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "disabled",
            "explicit"
          ]
        },
        "shell": {
          "type": "boolean",
          "const": false
        },
        "maxOutputBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "network",
        "shell",
        "maxOutputBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "root",
    "config",
    "operation",
    "targets",
    "revision",
    "requestedCapabilities",
    "executionPolicy"
  ],
  "additionalProperties": false
}
