{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "footgun.context-index.v1"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "path",
          "line",
          "column"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "resolved": {
            "type": "boolean"
          },
          "alias": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "line",
          "column",
          "resolved"
        ],
        "additionalProperties": false
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "callee": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "callee",
          "path",
          "line",
          "column"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "filesDiscovered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filesIndexed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skippedFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parseStatus": {
              "type": "string",
              "const": "complete"
            }
          },
          "required": [
            "filesDiscovered",
            "filesIndexed",
            "skippedFiles",
            "parseStatus"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "filesDiscovered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filesIndexed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skippedFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parseStatus": {
              "type": "string",
              "const": "partial"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "filesDiscovered",
            "filesIndexed",
            "skippedFiles",
            "parseStatus",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "filesDiscovered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filesIndexed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skippedFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parseStatus": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "filesDiscovered",
            "filesIndexed",
            "skippedFiles",
            "parseStatus",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "files",
    "definitions",
    "references",
    "calls",
    "coverage",
    "revision",
    "stale",
    "digest"
  ],
  "additionalProperties": false
}
