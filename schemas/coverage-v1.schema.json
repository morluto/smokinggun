{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scanner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "filesDiscovered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "filesAnalyzed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parseStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed",
        "unavailable"
      ]
    },
    "skippedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "scanner",
    "version",
    "language",
    "filesDiscovered",
    "filesAnalyzed",
    "parseStatus",
    "skippedFiles"
  ],
  "additionalProperties": false
}
